# /etc/nginx/sites-available/predmaint
# ============================================================
# Nginx reverse proxy for IoT Predictive Maintenance backend.
#
# Copy this file to your EC2 instance:
#   sudo cp predmaint.nginx /etc/nginx/sites-available/predmaint
#   sudo ln -s /etc/nginx/sites-available/predmaint /etc/nginx/sites-enabled/
#   sudo nginx -t && sudo systemctl reload nginx
#
# BEFORE using this file:
#   1. Replace YOUR_EC2_PUBLIC_IP with your actual EC2 IP or domain
#   2. If you have a domain + SSL, uncomment the HTTPS server block
#      and comment out the HTTP-only block
# ============================================================

# ---- HTTP only (no domain, direct IP access) ---- 
# Use this if you just want http://IP:80 to work
server {
    listen 80;
    server_name _;    # accepts any hostname / IP

    # REST API + Swagger
    location / {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 60s;
        proxy_connect_timeout 10s;
    }

    # WebSocket upgrade — MUST be a separate location block
    location /ws/ {
        proxy_pass         http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header   Upgrade    $http_upgrade;
        proxy_set_header   Connection "upgrade";
        proxy_set_header   Host       $host;
        proxy_read_timeout 86400s;     # 24 hours — keep WebSocket alive
        proxy_send_timeout 86400s;
    }
}

# ---- HTTPS with SSL (use this after running certbot) ----
# Uncomment this block and comment out the HTTP block above
