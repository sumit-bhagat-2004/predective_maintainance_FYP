# Frontend Environment Variables
# ============================================================
# COPY THIS FILE to .env.local (for local dev)
# or set these as environment variables in Vercel/your server.
#
# .env.local is gitignored — never commit it.
# ============================================================

# URL of your FastAPI backend (REST API)
# Local dev:      http://localhost:8000
# EC2/production: http://YOUR_EC2_PUBLIC_IP:8000
#                 OR https://api.yourdomain.com (if you set up a domain + SSL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# URL of your FastAPI backend (WebSocket)
# Local dev:      ws://localhost:8000
# EC2/production: ws://YOUR_EC2_PUBLIC_IP:8000
#                 OR wss://api.yourdomain.com (if SSL is configured)
NEXT_PUBLIC_WS_URL=ws://localhost:8000
