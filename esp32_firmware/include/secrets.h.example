// ============================================================
// secrets.h.example — COPY THIS TO secrets.h AND FILL IN VALUES
// secrets.h is gitignored and must NEVER be committed to git.
// ============================================================

#pragma once

// ---- Wi-Fi Credentials ----
#define WIFI_SSID     "YOUR_WIFI_SSID"
#define WIFI_PASSWORD "YOUR_WIFI_PASSWORD"

// ---- AWS IoT Endpoint ----
// Get from AWS Console → IoT Core → Settings → Device data endpoint
// OR: aws iot describe-endpoint --endpoint-type iot:Data-ATS
#define AWS_IOT_ENDPOINT "xxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com"
#define AWS_IOT_PORT     8883
#define AWS_THING_NAME   "ESP32-PredMaint"

// ---- AWS Root CA Certificate ----
// Download from: https://www.amazontrust.com/repository/AmazonRootCA1.pem
static const char AWS_ROOT_CA[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE_AMAZON_ROOT_CA_1_HERE
-----END CERTIFICATE-----
)EOF";

// ---- Device Certificate ----
// Download from AWS IoT Console when creating the Thing
static const char DEVICE_CERT[] PROGMEM = R"EOF(
-----BEGIN CERTIFICATE-----
PASTE_YOUR_DEVICE_CERTIFICATE_HERE
-----END CERTIFICATE-----
)EOF";

// ---- Device Private Key ----
// Download from AWS IoT Console when creating the Thing
static const char DEVICE_PRIVATE_KEY[] PROGMEM = R"EOF(
-----BEGIN RSA PRIVATE KEY-----
PASTE_YOUR_PRIVATE_KEY_HERE
-----END RSA PRIVATE KEY-----
)EOF";
