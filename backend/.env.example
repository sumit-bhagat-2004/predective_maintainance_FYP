# ============================================================
# .env.example — Copy to .env and fill in your values
# .env is gitignored and must NEVER be committed to git.
# ============================================================

# ---- AWS IoT Core ----
AWS_IOT_ENDPOINT=xxxxxxxxxxxx-ats.iot.ap-south-1.amazonaws.com
AWS_IOT_PORT=8883
AWS_THING_NAME=ESP32-PredMaint
AWS_TOPIC_PREFIX=predictive-maintenance/esp32

# ---- Paths to AWS certs (downloaded from AWS IoT Console) ----
# Store these somewhere outside the repo, e.g. ~/certs/
AWS_ROOT_CA_PATH=/home/user/certs/AmazonRootCA1.pem
AWS_DEVICE_CERT_PATH=/home/user/certs/device-certificate.pem.crt
AWS_DEVICE_KEY_PATH=/home/user/certs/private.pem.key

# ---- Database ----
DATABASE_URL=sqlite:///./data/sensor_data.db

# ---- Server ----
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=http://localhost:3000,https://your-frontend-domain.com
